{
    "name": "eltonwebnet/jasper-rdr",
    "version": "dev-master",
    "description": "Renderizador de Relatórios Jasper para Laravel — render local via JAR Java (datasource JSON), sem depender de um JasperReports Server.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Eltonwebnet\\JasperRdr\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Elton França Alencar",
            "email": "eltonwebnet@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "symfony/process": "^6.0|^7.0"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "*"
            ]
        }
    }
}
